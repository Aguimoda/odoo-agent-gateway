<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_assistant_chat" model="ir.actions.client">
        <field name="name">AI assistant</field>
        <field name="tag">agent_gateway_embed</field>
        <field name="params" eval="{'page': 'chat'}"/>
    </record>
    <record id="action_assistant_approvals" model="ir.actions.client">
        <field name="name">Approvals</field>
        <field name="tag">agent_gateway_embed</field>
        <field name="params" eval="{'page': 'approvals'}"/>
    </record>
    <record id="action_assistant_admin" model="ir.actions.client">
        <field name="name">Assistant administration</field>
        <field name="tag">agent_gateway_embed</field>
        <field name="params" eval="{'page': 'admin'}"/>
    </record>

    <menuitem id="menu_assistant_root" name="Assistant" sequence="90"
              web_icon="agent_gateway_connector,static/description/icon.png"
              groups="base.group_user"/>
    <menuitem id="menu_assistant_chat" name="Chat" parent="menu_assistant_root"
              action="action_assistant_chat" sequence="1"/>
    <menuitem id="menu_assistant_approvals" name="Approvals" parent="menu_assistant_root"
              action="action_assistant_approvals" sequence="2"/>
    <menuitem id="menu_assistant_admin" name="Administration" parent="menu_assistant_root"
              action="action_assistant_admin" sequence="3" groups="base.group_system"/>
</odoo>
